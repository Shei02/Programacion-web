{{/* usuario_list.templ: lista de Usuarios usando los campos del modelo sqlc */}}

{{define "usuario_list"}}
<section>
  <h2>{{if .ListTitle}}{{.ListTitle}}{{else}}Usuarios{{end}}</h2>

  {{if .Usuarios}}
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Email</th>
        <th>Fecha Nac.</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{range .Usuarios}}
      <tr>
        <td>{{.Idu}}</td>
        <td>{{.Nomusu}}</td>
        <td>{{.Email}}</td>
        <td>{{.Fechanac.Format "2006-01-02"}}</td>
        <td>
          <a class="btn small" href="/usuarios/editar?id={{.Idu}}">Editar</a>
          <form method="post" action="/usuarios/delete" style="display:inline">
            <input type="hidden" name="idu" value="{{.Idu}}">
            <button class="btn small" type="submit">Eliminar</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
    <p>No se encontraron usuarios.</p>
  {{end}}
</section>
{{end}}
