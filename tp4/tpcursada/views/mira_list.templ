{{/* mira_list.templ: lista de Miras / Calificaciones */}}

{{define "mira_list"}}
<section>
  <h2>{{if .ListTitle}}{{.ListTitle}}{{else}}Calificaciones (Miras){{end}}</h2>

  {{if .Miras}}
  <table>
    <thead>
      <tr>
        <th>Id Película</th>
        <th>Id Usuario</th>
        <th>¿Le gustó?</th>
        <th>Calificación</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{range .Miras}}
      <tr>
        <td>{{.Idp}}</td>
        <td>{{.Idu}}</td>
        <td>{{.Gustoono}}</td>
        <td>{{.Calif}}</td>
        <td>
          <a class="btn small" href="/miras/editar?idu={{.Idu}}&idp={{.Idp}}">Editar</a>
          <button class="btn small danger" onclick="deleteMira({{.Idp}}, {{.Idu}})">Eliminar</button>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
    <p>No se encontraron calificaciones.</p>
  {{end}}
</section>
<script>
function deleteMira(idp, idu) {
  fetch('/api/miras/' + idp + '/' + idu, { method: 'DELETE' })
    .then(function(res) {
      if (res.status === 204) {
        location.reload();
      } else {
        res.text().then(function(t){ alert('Error al borrar: ' + t); });
      }
    })
    .catch(function(err){ alert('Error de red: ' + err); });
}
</script>
{{end}}
