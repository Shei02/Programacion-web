{{/* mira_list.templ: lista de Miras / Calificaciones */}}

{{define "mira_list"}}
<section>
  <h2>{{if .ListTitle}}{{.ListTitle}}{{else}}Calificaciones (Miras){{end}}</h2>

  {{if .Miras}}
  <table>
    <thead>
      <tr>
        <th>Id Película</th>
        <th>Id Usuario</th>
        <th>¿Le gustó?</th>
        <th>Calificación</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{range .Miras}}
      <tr>
        <td>{{.Idp}}</td>
        <td>{{.Idu}}</td>
        <td>{{.Gustoono}}</td>
        <td>{{.Calif}}</td>
        <td>
          <a class="btn small" hx-get="/miras/editar?idu={{.Idu}}&idp={{.Idp}}" hx-target="#mira-form-container" hx-swap="outerHTML">Editar</a>
          <form method="post" action="/miras/delete" style="display:inline" hx-post="/miras/delete" hx-target="#mira-list-container" hx-swap="outerHTML" hx-confirm="¿Eliminar esta calificación?">
            <input type="hidden" name="idp" value="{{.Idp}}">
            <input type="hidden" name="idu" value="{{.Idu}}">
            <button class="btn small danger" type="submit">Eliminar</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
    <p>No se encontraron calificaciones.</p>
  {{end}}
</section>
<!-- Deleting miras ahora se hace vía HTMX (form hx-post) y el servidor devuelve
     el fragmento actualizado de la lista que reemplaza #mira-list-container -->
{{end}}
