{{/* index.templ: página de inicio - hero + cards + vistas rápidas */}}

{{define "index"}}
  <header>
    <p>Bienvenido a la plataforma de películas en proceso de dos estudiantes cursando Programación web. Aquí podrás ver, encontrar y buscar tus películas favoritas de manera sencilla y eficiente — ¡ayudándote a decidir rápidamente qué ver!</p>
    <p>Además vas a tener la posibilidad de calificar tu película.</p>
  </header>

  <section class="hero">
    <h2>Bienvenido a la plataforma de películas</h2>
    <p>Ve nuestras películas disponibles, gestiona usuarios y registra calificaciones desde las páginas dedicadas.</p>

    <div class="cards">
      <article class="card">
        <h3>Películas</h3>
        <p>Explora la colección de películas. Podés ver, editar o agregar nuevas películas.</p>
        <a class="btn" href="/peliculas">Ver películas</a>
      </article>

      <article class="card">
        <h3>Usuarios</h3>
        <p>¡Conoce nuestros usuarios! Podés crear, editar y eliminar perfiles.</p>
        <a class="btn" href="/usuarios">Ver usuarios</a>
      </article>

      <article class="card">
        <h3>Calificaciones</h3>
        <p>¿Te gustó la película? Podés calificarla desde tu usuario.</p>
        <a class="btn" href="/miras">Ver calificaciones</a>
      </article>
    </div>
  </section>
{{end}}
