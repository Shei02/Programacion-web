{{/* entity_list.templ: ejemplo para la entidad "Pelicula".
   Datos esperados al ejecutar la plantilla:
   - .Peliculas : slice de structs con campos ID, Titulo, Anio, Director
   - .ListTitle  : (opcional) título del listado
   Si tu entidad tiene otros campos, adapta los nombres abajo.
*/}}

{{define "pelicula_list"}}
<section>
  <h2>{{if .ListTitle}}{{.ListTitle}}{{else}}Películas{{end}}</h2>

  {{if .Peliculas}}
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Título</th>
        <th>Año</th>
        <th>Director</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{range .Peliculas}}
      <tr>
        <td>{{.ID}}</td>
        <td>{{.Titulo}}</td>
        <td>{{.Anio}}</td>
        <td>{{.Director}}</td>
        <td>
          <a href="/pelicula/{{.ID}}">Ver</a>
          <!-- Puedes agregar enlaces para editar/eliminar -->
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
    <p>No se encontraron elementos.</p>
  {{end}}
</section>
{{end}}
