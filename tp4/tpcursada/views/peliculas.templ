{{/* Página de Películas: incluye formulario y lista */}}

{{define "peliculas"}}
<section>
  <div class="grid">
    <div>
      {{/* Contenedor del formulario para edición/creación; HTMX cargará aquí el form */}}
      <div id="pelicula-form-container">
        {{template "pelicula_form" .}}
      </div>
    </div>
    <div>
      {{/* Contenedor de la lista: HTMX reemplazará este bloque con el fragmento retornado
         por el servidor (hx-target="#pelicula-list-container" y hx-swap="outerHTML") */}}
      <div id="pelicula-list-container">
        {{template "pelicula_list" .}}
      </div>
    </div>
  </div>
</section>
{{end}}
