{{/* mira_form.templ: formulario para crear/editar una Mira (calificación) */}}

{{define "mira_form"}}
<section>
  <h2>{{if .FormTitle}}{{.FormTitle}}{{else}}Agregar / Editar Calificación{{end}}</h2>

  <form method="post" action="{{if .Action}}{{.Action}}{{else}}/miras{{end}}">
    <label for="idp">Película</label>
    <select id="idp" name="idp">
      {{range .Peliculas}}
        <option value="{{.Idp}}" {{if $.Mira}}{{if eq $.Mira.Idp .Idp}}selected{{end}}{{end}}>{{.Titulo}}</option>
      {{end}}
    </select>

    <label for="idu">Usuario</label>
    <select id="idu" name="idu">
      {{range .Usuarios}}
        <option value="{{.Idu}}" {{if $.Mira}}{{if eq $.Mira.Idu .Idu}}selected{{end}}{{end}}>{{.Nomusu}}</option>
      {{end}}
    </select>

    <label for="gustoono">¿Le gustó?</label>
    <select id="gustoono" name="gustoono">
      <option value="sí" {{if .Mira}}{{if eq .Mira.Gustoono "sí"}}selected{{end}}{{end}}>Sí</option>
      <option value="no"  {{if .Mira}}{{if eq .Mira.Gustoono "no"}}selected{{end}}{{end}}>No</option>
    </select>

    <label for="calif">Calificación (1-5)</label>
    <input id="calif" name="calif" type="number" min="1" max="5" value="{{if .Mira}}{{.Mira.Calif}}{{end}}">

    <button type="submit">Guardar</button>
  </form>
</section>
{{end}}
