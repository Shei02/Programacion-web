{{/* pelicula_list.templ: lista de Películas usando los campos del modelo sqlc */}}

{{define "pelicula_list"}}
<section>
  <h2>{{if .ListTitle}}{{.ListTitle}}{{else}}Películas{{end}}</h2>

  {{if .Peliculas}}
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Título</th>
        <th>Duración (min)</th>
        <th>Director</th>
        <th>Actores</th>
        <th>Edad mínima</th>
        <th>Año estreno</th>
        <th>Sinopsis</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{range .Peliculas}}
      <tr>
        <td>{{.Idp}}</td>
        <td>{{.Titulo}}</td>
        <td>{{.Duracion}}</td>
        <td>{{.Director}}</td>
        <td>{{.Actores}}</td>
        <td>{{.Edadmin}}</td>
        <td>{{.Anioestr}}</td>
        <td>{{.Sinopsis}}</td>
        <td>
          <a class="btn small" hx-get="/peliculas/editar?id={{.Idp}}" hx-target="#pelicula-form-container" hx-swap="outerHTML">Editar</a>
          <form method="post" action="/peliculas/delete" style="display:inline" hx-post="/peliculas/delete" hx-target="#pelicula-list-container" hx-swap="outerHTML" hx-confirm="¿Eliminar esta película?">
            <input type="hidden" name="idp" value="{{.Idp}}">
            <button class="btn small" type="submit">Eliminar</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
    <p>No se encontraron películas.</p>
  {{end}}
</section>
{{end}}
