{{/* pelicula_list.templ: lista de Películas usando los campos del modelo sqlc */}}

{{define "pelicula_list"}}
<div id="pelicula-list-container">
  <section>
  <h2>{{if .ListTitle}}{{.ListTitle}}{{else}}Películas{{end}}</h2>

  {{/* Mensajes de error/estado que pueden venir desde el servidor (HTMX) */}}
  {{if .Error}}
  <div class="flash error">{{.Error}}</div>
  {{end}}

  {{if .Peliculas}}
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Título</th>
        <th>Duración (min)</th>
        <th>Director</th>
        <th>Actores</th>
        <th>Edad mínima</th>
        <th>Año estreno</th>
        <th>Sinopsis</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{range .Peliculas}}
      <tr>
        <td>{{.Idp}}</td>
        <td>{{.Titulo}}</td>
        <td>{{.Duracion}}</td>
        <td>{{.Director}}</td>
        <td>{{.Actores}}</td>
        <td>{{.Edadmin}}</td>
        <td>{{.Anioestr}}</td>
        <td>{{.Sinopsis}}</td>
        <td>
          <a href="/peliculas/editar?id={{.Idp}}" class="btn small" hx-get="/peliculas/editar?id={{.Idp}}" hx-target="#pelicula-form-container" hx-swap="outerHTML">Editar</a>
          {{/* Botón de borrado sin recarga usando HTMX: envía DELETE a /peliculas/{id}
               hx-target="closest tr" indica que HTMX debe reemplazar la fila <tr>
               por la respuesta del servidor; como el servidor responde vacío con 200,
               la fila terminará eliminada del DOM. */}}
           <form method="post" action="/peliculas/delete" hx-post="/peliculas/delete" hx-target="#pelicula-list-container" hx-swap="outerHTML" style="display:inline">
            <input type="hidden" name="idp" value="{{.Idp}}">
            <button type="submit" class="btn small">Eliminar</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
    <p>No se encontraron películas.</p>
  {{end}}
  </section>
</div>
{{end}}
