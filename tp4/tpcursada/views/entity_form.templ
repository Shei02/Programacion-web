{{/* entity_form.templ: formulario ejemplo para crear/editar una Película.
   Datos esperados:
   - .Pelicula : struct opcional con campos Titulo, Anio, Director y ID
   - .Action   : URL donde se envía el formulario (por defecto /api/peliculas)
*/}}

{{define "pelicula_form"}}
<section>
  <h2>{{if .FormTitle}}{{.FormTitle}}{{else}}Crear / Editar Película{{end}}</h2>

  <form method="post" action="{{if .Action}}{{.Action}}{{else}}/api/peliculas{{end}}">
    {{/* En caso de editar, podrías incluir un campo oculto con el ID */}}
    {{if .Pelicula.ID}}<input type="hidden" name="id" value="{{.Pelicula.ID}}">{{end}}

    <label for="titulo">Título</label>
    <input id="titulo" name="titulo" type="text" value="{{.Pelicula.Titulo}}" required>

    <label for="anio">Año</label>
    <input id="anio" name="anio" type="number" value="{{.Pelicula.Anio}}">

    <label for="director">Director</label>
    <input id="director" name="director" type="text" value="{{.Pelicula.Director}}">

    <button type="submit">Guardar</button>
  </form>
</section>
{{end}}
